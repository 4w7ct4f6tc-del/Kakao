rules_version = '2';
// All writes go through the KAKAO API (Admin SDK bypasses these rules).
// Clients may only read their own data, plus published apps.
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow write: if false;
      match /private/{doc} { allow read, write: if false; }   // encrypted keys, security answers
    }
    match /apps/{id} {
      allow read: if resource.data.status == 'live' || isOwner(resource.data.userId);
      allow write: if false;
    }
    match /chats/{id}    { allow read: if isOwner(resource.data.userId); allow write: if false; }
    match /videos/{id}   { allow read: if isOwner(resource.data.userId); allow write: if false; }
    match /payments/{id} { allow read: if isOwner(resource.data.userId); allow write: if false; }
    match /integrations/{id} { allow read, write: if false; }  // tokens never leave the server
    match /{document=**} { allow read, write: if false; }
  }
}
