# Copy to web/.env.local  (Vercel: Project → Settings → Environment Variables)
# One link: proxy /api to the Render API (recommended)
KAKAO_API_ORIGIN=https://kakao-api.onrender.com
NEXT_PUBLIC_KAKAO_API=/api
# ...or call Firebase Functions directly instead:
# NEXT_PUBLIC_KAKAO_API=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/api
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_PROJECT_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_WEB_APP_ID
# Your main web host (custom domains of user apps are resolved by middleware)
NEXT_PUBLIC_MAIN_HOSTS=localhost,YOUR_WEB_DOMAIN
