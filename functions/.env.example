# ======================================================================
#  KAKAO backend secrets — copy to functions/.env and fill in.
#  Anything left as YOUR_... is treated as "not configured" and the
#  feature falls back to the next option instead of crashing.
# ======================================================================

# ---- Core ----
PUBLIC_API_URL=https://us-central1-YOUR_PROJECT_ID.cloudfunctions.net/api
WEB_BASE_URL=https://YOUR_WEB_DOMAIN
STORAGE_BUCKET=YOUR_PROJECT_ID.appspot.com
FUNCTIONS_REGION=us-central1
# 32 random bytes base64:  openssl rand -base64 32
ENCRYPTION_KEY=YOUR_32_BYTE_BASE64_KEY
STATE_SECRET=YOUR_RANDOM_STRING
# Show OTP code in API response (ONLY for local testing!)
DEV_SHOW_OTP=false

# ---- AI engines (platform keys; users can also bring their own) ----
OPENAI_API_KEY=YOUR_OPENAI_KEY
OPENAI_MODEL=gpt-4o
OPENAI_MODEL_MINI=gpt-4o-mini
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_STT_MODEL=whisper-1

ANTHROPIC_API_KEY=YOUR_ANTHROPIC_KEY
CLAUDE_MODEL_ULTRA=claude-opus-5-5
CLAUDE_MODEL_PRO=claude-sonnet-5-5
CLAUDE_MODEL_BASIC=claude-haiku-5-5

GEMINI_API_KEY=YOUR_GEMINI_KEY
GEMINI_MODEL=gemini-2.5-pro
IMAGEN_MODEL=imagen-4.0-generate-001

# Meta Llama through any OpenAI-compatible host (Groq is free & fast)
META_LLAMA_API_KEY=YOUR_GROQ_OR_TOGETHER_KEY
META_LLAMA_BASE_URL=https://api.groq.com/openai/v1
META_MODEL=llama-3.3-70b-versatile

# ---- Translation (optional; falls back to AI) ----
DEEPL_API_KEY=YOUR_DEEPL_KEY
GOOGLE_TRANSLATE_API_KEY=YOUR_GOOGLE_TRANSLATE_KEY

# ---- Voice ----
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_KEY
ELEVENLABS_MODEL=eleven_multilingual_v2
# Defaults (multilingual, speak every language)
ELEVENLABS_VOICE_MALE=pNInz6obpgDQGcFmaJgB
ELEVENLABS_VOICE_FEMALE=EXAVITQu4vr4xnSDxMaL
# Bahraini Arabic — the most important one. ElevenLabs → Voice Library → search
# "Gulf Arabic" / "Khaleeji" / "Bahraini" → Add to my voices → copy the Voice ID.
ELEVENLABS_VOICE_BAHRAINI_MALE=YOUR_BAHRAINI_MALE_VOICE_ID
ELEVENLABS_VOICE_BAHRAINI_FEMALE=YOUR_BAHRAINI_FEMALE_VOICE_ID
# Optional per-accent voices (male / female)
ELEVENLABS_VOICE_EN_US_MALE=
ELEVENLABS_VOICE_EN_US_FEMALE=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_VOICE_EN_UK_MALE=JBFqnCBsd6RMkjVDRZzb
ELEVENLABS_VOICE_EN_UK_FEMALE=Xb7hH8MSUJpSbSDYk0k2
ELEVENLABS_VOICE_FR_MALE=
ELEVENLABS_VOICE_FR_FEMALE=
ELEVENLABS_VOICE_HI_MALE=
ELEVENLABS_VOICE_HI_FEMALE=

# ---- OTP: SMS + WhatsApp (Twilio) + Email (SendGrid) ----
TWILIO_ACCOUNT_SID=YOUR_TWILIO_SID
TWILIO_AUTH_TOKEN=YOUR_TWILIO_TOKEN
TWILIO_SMS_FROM=+1YOURNUMBER
TWILIO_MESSAGING_SERVICE_SID=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Or Meta WhatsApp Business Cloud API (preferred for production OTP templates)
WHATSAPP_CLOUD_TOKEN=YOUR_WHATSAPP_CLOUD_TOKEN
WHATSAPP_PHONE_NUMBER_ID=YOUR_PHONE_NUMBER_ID
WHATSAPP_OTP_TEMPLATE=YOUR_AUTH_TEMPLATE_NAME
WHATSAPP_TEMPLATE_LANG=en
SENDGRID_API_KEY=YOUR_SENDGRID_KEY
SENDGRID_FROM_EMAIL=no-reply@YOUR_DOMAIN
SENDGRID_FROM_NAME=KAkAo

# ---- OAuth apps (login on Windows + "Connect X" integrations) ----
# Redirect URIs to register at each provider:
#   {PUBLIC_API_URL}/auth/bridge/callback   (login)
#   {PUBLIC_API_URL}/integrations/callback  (connections)
GOOGLE_OAUTH_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_OAUTH_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET
GITHUB_OAUTH_CLIENT_ID=YOUR_GITHUB_CLIENT_ID
GITHUB_OAUTH_CLIENT_SECRET=YOUR_GITHUB_CLIENT_SECRET
FACEBOOK_APP_ID=YOUR_FACEBOOK_APP_ID
FACEBOOK_APP_SECRET=YOUR_FACEBOOK_APP_SECRET
APPLE_SERVICES_ID=YOUR_APPLE_SERVICES_ID
APPLE_TEAM_ID=YOUR_APPLE_TEAM_ID
APPLE_KEY_ID=YOUR_APPLE_KEY_ID
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_P8_KEY\n-----END PRIVATE KEY-----"
STRIPE_CONNECT_CLIENT_ID=YOUR_STRIPE_CONNECT_CLIENT_ID
VERCEL_INTEGRATION_SLUG=YOUR_INTEGRATION_SLUG
VERCEL_CLIENT_ID=YOUR_VERCEL_CLIENT_ID
VERCEL_CLIENT_SECRET=YOUR_VERCEL_CLIENT_SECRET
TIKTOK_CLIENT_KEY=YOUR_TIKTOK_CLIENT_KEY
TIKTOK_CLIENT_SECRET=YOUR_TIKTOK_CLIENT_SECRET
SUPABASE_OAUTH_CLIENT_ID=YOUR_SUPABASE_CLIENT_ID
SUPABASE_OAUTH_CLIENT_SECRET=YOUR_SUPABASE_CLIENT_SECRET

# ---- Payments ----
STRIPE_SECRET_KEY=YOUR_STRIPE_SECRET_KEY
STRIPE_WEBHOOK_SECRET=YOUR_STRIPE_WEBHOOK_SECRET
STRIPE_PRICE_PRO=YOUR_STRIPE_PRICE_ID_PRO
STRIPE_PRICE_ULTRA=YOUR_STRIPE_PRICE_ID_ULTRA
# BenefitPay (Bahrain) via Tap Payments
TAP_SECRET_KEY=YOUR_TAP_SECRET_KEY
PAYPAL_CLIENT_ID=YOUR_PAYPAL_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SECRET
PAYPAL_BASE_URL=https://api-m.paypal.com
PRICE_PRO_USD=9.99
PRICE_ULTRA_USD=24.99
PRICE_PRO_BHD=3.900
PRICE_ULTRA_BHD=9.900

# ---- Publishing ----
VERCEL_TOKEN=YOUR_VERCEL_TOKEN
VERCEL_PROJECT_ID=YOUR_VERCEL_PROJECT_ID
VERCEL_TEAM_ID=
CLOUDFLARE_API_TOKEN=YOUR_CLOUDFLARE_TOKEN
# Free subdomains for users: <app>.<APPS_BASE_DOMAIN>  (a zone in your Cloudflare)
APPS_BASE_DOMAIN=YOUR_APPS_DOMAIN
GITHUB_TOKEN=YOUR_GITHUB_TOKEN
GITHUB_OWNER=YOUR_GITHUB_USER_OR_ORG
GITHUB_TEMPLATE_REPO=YOUR_GITHUB_USER_OR_ORG/kakao-app-template

# ---- Story to video ----
VIDEO_SERVICE_URL=https://YOUR_RENDER_SERVICE.onrender.com
VIDEO_SERVICE_SECRET=YOUR_RANDOM_STRING
MUSIC_TRACK_DEFAULT=https://YOUR_CDN/music/calm.mp3
MUSIC_TRACK_HAPPY=
MUSIC_TRACK_EPIC=
MUSIC_API_URL=
MUSIC_API_KEY=
